#get genes only from GFF
grep -F -f opsin_loc_ids.txt genomic.gff | \
  awk '$3=="gene"' | \
  awk '{
    match($9, /Name=([^;]+)/, nm);
    print $1"\t"$4"\t"$5"\t"nm[1]"\t"$7
  }' > found_opsins.bed

#make 50kb windows of opsins
bedtools slop \
  -i found_opsins.bed \
  -g genome.sizes \
  -b 50000 \
  > opsin_windows_50kb.bed

#clean and sort repeatmasker bed file
awk 'BEGIN{OFS="\t"} {print $1, $2, $3, $11}' hydra_105_repeats.bed > TEs.clean.bed
sort -k1,1 -k2,2n TEs.clean.bed > TEs.sorted.bed

#get TE coverage in windows
bedtools merge -i TEs.sorted.bed > TEs.merged.bed

bedtools coverage \
  -a opsin_windows_50kb.bed \
  -b TEs.merged.bed \
  > opsin_TE_coverage.txt

#get coverage at family level
cut -f4 TEs.sorted.bed | sort -u > te_families.txt
> opsin_family_coverage.txt

while read family; do
  awk -v fam="$family" '$4 == fam' TEs.sorted.bed > tmp_family.bed
  bedtools merge -i tmp_family.bed > tmp_family_merged.bed

  bedtools coverage \
    -a opsin_windows_50kb.bed \
    -b tmp_family_merged.bed \
    | awk -v fam="$family" 'BEGIN{OFS="\t"} {print $4, fam, $9*100}' \
    >> opsin_family_coverage.txt

done < te_families.txt
rm tmp_family.bed tmp_family_merged.bed



