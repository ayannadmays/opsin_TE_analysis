#order opsins by how much TE coverage they have
gene_order <- opsin %>%
  filter(family %in% focal_families) %>%
  group_by(gene) %>%
  summarize(total = sum(pct)) %>%
  arrange(total) %>%
  pull(gene)

#make plot
opsin %>%
  filter(family %in% focal_families) %>%
  mutate(
    color_key = family_to_color_key(family),
    gene = factor(gene, levels = gene_order)
  ) %>%
  ggplot(aes(x = gene, y = pct, fill = color_key)) +
  geom_col() +
  scale_fill_manual(values = te_colors, name = "TE family") +
  scale_x_discrete(limits = gene_order) +
  labs(
    x = NULL,
    y = "% 50kb window covered",
    title = "TE family coverage around opsin genes"
  ) +
  theme_minimal() +
  theme(
    axis.text.x  = element_text(angle = 45, hjust = 1, size = 7),
    legend.text  = element_text(size = 7),
    legend.key.size = unit(0.4, "cm")
  )

