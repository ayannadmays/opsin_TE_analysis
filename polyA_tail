#make python script to make a table of polyA lengths from target opsin genes bed file
import argparse
from Bio import SeqIO
from Bio.Seq import Seq
import pandas as pd

def longest_homopolymer(seq, base):
    """Return length and start position of longest homopolymer run of base in seq"""
    max_len = 0
    max_start = None
    count = 0
    for i, b in enumerate(seq):
        if b.upper() == base:
            count += 1
            if count > max_len:
                max_len = count
                max_start = i - count + 1
        else:
            count = 0
    return max_len, max_start

def extract_downstream(seq, strand, window=500):
    """Get downstream sequence based on strand"""
    if strand == '+':
        return seq[:window]
    else:
        return str(Seq(seq[-window:]).reverse_complement())

def main():
    parser = argparse.ArgumentParser(description="Scan opsins for downstream polyA tails")
    parser.add_argument("-b", "--bed", required=True, help="Opsin BED file (chrom start end name strand)")
    parser.add_argument("-f", "--fasta", required=True, help="Genome FASTA")
    parser.add_argument("-w", "--window", type=int, default=500, help="Downstream window size (bp)")
    parser.add_argument("-o", "--out", default="opsin_polyA_report.txt", help="Output file")
    args = parser.parse_args()

    # Load genome
    genome = SeqIO.to_dict(SeqIO.parse(args.fasta, "fasta"))

    results = []

    with open(args.bed) as bed:
        for line in bed:
            if line.startswith('#') or line.strip() == '':
                continue
            cols = line.strip().split()
            chrom, start, end, name, strand = cols[0], int(cols[1]), int(cols[2]), cols[3], cols[4]
            
            if chrom not in genome:
                print(f"Warning: {chrom} not found in genome fasta")
                continue

            seq = genome[chrom].seq
            # extract downstream window
            if strand == '+':
                window_seq = seq[end:end + args.window]
            else:
                window_seq = seq[max(0, start - args.window):start].reverse_complement()
            
            window_seq = str(window_seq).upper()
            
            # scan polyA on + and - strands
            polyA_len, polyA_start = longest_homopolymer(window_seq, 'A')
            polyT_len, polyT_start = longest_homopolymer(window_seq, 'T')

            results.append({
                'opsin': name,
                'strand': strand,
                'polyA_len': polyA_len,
                'polyA_start': polyA_start,
                'polyT_len': polyT_len,
                'polyT_start': polyT_start
            })

    # Save results
    df = pd.DataFrame(results)
    df.to_csv(args.out, sep='\t', index=False)
    print(f"PolyA scan complete. Results saved to {args.out}")

if __name__ == "__main__":
    main()

