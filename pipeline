bedtools window -a opsin_only.bed -b repeatmasker.bed -w 50000 > opsin_TE_pairs.tsv

### clean columns so you have gene_id, TE_family, and TE_subfamily, removes unecessary residuals from bed files
import pandas as pd
# make columns
cols = ["gene_chr","gene_start","gene_end","gene_info","dot","gene_strand",
        "te_chr","te_start","te_end","te_id","te_div","te_strand"]
# Read the table as strings
df = pd.read_csv("opsin_TE_pairs.tsv", sep="\t", names=cols, dtype=str)
#Ensure strings for extraction
df['gene_info'] = df['gene_info'].astype(str)
df['te_id'] = df['te_id'].astype(str)
#Extract Gene_ID
df['Gene_ID'] = df['gene_info'].str.extract(r'gene=(LOC\d+)')
#Extract TE subfamily and family
#Split te_id on '|' first to isolate 'rnd-1_family-36:L2:LINE'
te_split_pipe = df['te_id'].str.split('|')
te_info = te_split_pipe.str[3]  # fourth element is the "rnd-1_family-36:L2:LINE"
#Now split that field by ':' to get subfamily and family
te_info_split = te_info.str.split(':')
df['TE_subfamily'] = te_info_split.str[1]  # middle field: subfamily
df['TE_family'] = te_info_split.str[2]     # last field: family
#Simplify table
simplified = df[['Gene_ID', 'TE_family', 'TE_subfamily']].drop_duplicates()
#Save
simplified.to_csv("opsin_TE_simplified.tsv", sep="\t", index=False)
print("Simplified Gene–TE table saved as 'opsin_TE_simplified.tsv")
